{
  "id": "PFEGoogleJobsDiscovery",
  "name": "PFE - Google Jobs discovery",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "days", "daysInterval": 2}]}},
      "id": "schedule-google-jobs",
      "name": "Every 2 days",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/collect/profile",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"source\":\"google-jobs\",\"location\":\"France\",\"max_queries\":4,\"limit_per_query\":10}",
        "options": {"timeout": 120000}
      },
      "id": "collect-google-jobs",
      "name": "Collect Google Jobs discovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    }
  ],
  "connections": {"Every 2 days": {"main": [[{"node": "Collect Google Jobs discovery", "type": "main", "index": 0}]]}},
  "pinData": {},
  "settings": {"executionOrder": "v1"},
  "active": false
}
