# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_PFE_AUTH_ENABLED=false

# Local Docker/n8n. n8n generates its encryption key in the persistent volume.
N8N_IMAGE=n8nio/n8n:latest
PFE_DB_PATH=jobs.sqlite3
# Optional comma-separated override, for example: greenhouse:dataiku,ashby:alan
PFE_ATS_TARGETS=

# France Travail API Offres d'emploi
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Override only if the France Travail portal gives you different values.
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token
FRANCE_TRAVAIL_SEARCH_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_SCOPE=o2dsoffre api_offresdemploiv2

# Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Jobs via SerpApi (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=
